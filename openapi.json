{
  "openapi": "3.0.3",
  "info": {
    "title": "Rate Limiter Demo",
    "version": "1.0.0"
  },
  "paths": {
    "/ping": {
      "get": {
        "summary": "Rate-limited ping",
        "responses": {
          "200": {
            "description": "pong"
          },
          "429": {
            "description": "rate limit exceeded"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}